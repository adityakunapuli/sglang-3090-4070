# ── PostgreSQL (downstream shared database `db` on the proxy network) ──
MYHEALTH_DB_USER=myhealth
MYHEALTH_DB_PASS=change-me
MYHEALTH_DB_HOST=db
MYHEALTH_DB_PORT=5432
MYHEALTH_DB_NAME=myhealth_auth

# ── Anthem (Elevance Health) ────────────────────────────────────
CLIENT_ID=your_anthem_client_id
CLIENT_SECRET=your_anthem_client_secret
FHIR_PLAN=AnthemBlueCrossBlueShield

# Redirect URI must match what was registered with the provider. Only used as
# the callback argument when building the authorize URL; no hosting required.
REDIRECT_URI=https://localhost/callback

# ── Epic providers (one block per provider) ─────────────────────
# UCLA example (dockers' EPIC_CLIENT_ID/EPIC_SECRET are honored as fallbacks):
UCLA_CLIENT_ID=your_ucla_client_id
UCLA_SECRET=your_ucla_secret

# ── Job scheduler ───────────────────────────────────────────────
JOB_DAEMON=1
JOB_INTERVAL_MINUTES=360