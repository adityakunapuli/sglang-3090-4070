# ── Secrets / env ────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env

# ── PHI/PII outputs (never commit) ──────────────────────────────
.archive/
reports/
*.docx
*.pdf
# Contains sensitive data — never commit (runtime-generated report source)
backend/src/myhealth_fhir/services/report_generator.py

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ── Frontend node ───────────────────────────────────────────────
node_modules/
frontend/dist/
*.local

# ── DB artifacts ────────────────────────────────────────────────
*.db
*.jsonl
postgres_data/

# Database backups (pg_dump; contain PHI) — never commit
db-backups/

# ── Editors / OS ────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
BENEFITS.md

# ── Re-include ORM source package ───────────────────────────────
# Root repo .gitignore has broad data-dir patterns (**/db/, **/data/)
# meant for container stacks; without this negation the entire
# backend/src/myhealth_fhir/db/ source package is silently untracked.
!backend/src/myhealth_fhir/db/