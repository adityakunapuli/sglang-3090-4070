# Services

.archive/
bifrost/
blocky/
hermes/
traefik/
homepage/public/


# Global generic ignores (Data, Logs, Caches, Backups, Sensitive)
**/.lib/
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3
**/*.log
**/*.bak
**/*.backup
**/*.tmp
**/*.pkl
**/*.zip
**/*.tar.gz
**/*.tar.xz
**/*.pid
**/*.rdb
**/*.pyc
**/*.pub
**/*.key
**/*.pkey
**/*.pem
**/*.crt
**/*.cert
**/*.certs
**/*.p12
**/*.tls
**/*.onnx
**/*.pt
**/*.bin
**/*.weights
**/*.engine
**/*.model
**/*.torrent
**/*.json.lock
**/*.conf
**/*.xsd
**/*.tmpl
**/*.csv
**/__pycache__/
**/.venv/
**/venv/
**/.idea/
**/.ruff_cache/
**/.DS_Store
**/.directory
**/.lock
**/.locks
**/.no_exist
**/.claude
**/.env
**/.jwt_secret
**/.exports
**/*.secret
**/*.secret.*
**/.telemetry_collected
**/.index_version
**/.search_stats.json
**/.timeline
**/.vacuum
**/.__*

# YAML files (ignore configs, but keep docker-compose and examples)
**/*.yaml
**/*.yml
!**/docker-compose.yml
!**/docker-compose.yaml
!**/docker-compose.*.yml
!**/docker-compose.*.yaml
!**/example-config/
!**/EXAMPLE.yml
!**/EXAMPLE.yaml
!**/*.SAMPLE
!**/*.SAMPLE.yml
!**/*.SAMPLE.yaml

# Ignore large/sensitive data and work directories across all services
**/Backups/
**/backups/
**/backup/
**/cache/
**/metadata/
**/logs/
**/log/
**/data/
**/*_data/
**/*-data/
**/work/
**/db/
**/redis/
**/postgres/
**/storage/
**/index/
**/migrations/
**/temp/
**/tmp/
**/node_modules/
**/snapshots/
**/blobs/
**/refs/
**/model_cache/
**/workspaces/
**/skills/
**/config/
**/conf/
**/secrets/
**/*_secrets/
**/*-secrets/
**/sessions/
**/webui-state/
**/webui_state/
**/profiles/

.archive/
# Specific sensitive or generated files
frigate/config/config.yml
media-proxy-hub/.env
paperless-ngx/.env
immich/.env

# Explicitly include the SAMPLE files
!.env.SAMPLE
!*.SAMPLE
!**/EXAMPLE.env
