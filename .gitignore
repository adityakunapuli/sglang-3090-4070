# YAML files (ignore configs, but keep docker-compose and examples)
**/*.yaml
**/*.yml
!**/docker-compose.yml
!**/docker-compose.yaml
!**/docker-compose.*.yml
!**/docker-compose.*.yaml
!**/example-config/
!**/EXAMPLE.yml
!**/EXAMPLE.yaml
!**/*.SAMPLE
!**/*.SAMPLE.yml
!**/*.SAMPLE.yaml

